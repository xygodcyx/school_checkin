# ==================== 基础配置 ====================
NAME=YourName
# 服务监听端口
PORT=3000
# 服务对外访问地址（邮件按钮会使用该地址，生产环境必须是公网可访问的 HTTPS 地址）
# 只填协议 + 域名 + 端口，不要带路径，例如 https://checkin.example.com
BASE_URL=https://checkin.example.com
# Webhook 操作密钥，建议使用至少 32 位随机字符串
WEBHOOK_SECRET=change-me-to-a-long-random-string
# 时区，默认北京时间
APP_TIMEZONE=Asia/Shanghai

# ==================== 签到配置 ====================
# 签到任务 ID
THREAD_ID=183058660
# 每天自动签到时间（24 小时制）
CHECKIN_HOUR=18
CHECKIN_MINUTE=0
# 可选：自定义签到坐标和地点文本
# CHECKIN_LATITUDE=28.423147
# CHECKIN_LONGITUDE=117.976543
# CHECKIN_LOCATION_LABEL=上饶市信州区•上饶师范学院

# ==================== Token 提醒配置 ====================
# 距离过期多少小时开始提醒（默认 48 小时）
TOKEN_WARNING_HOURS=48
# 仅在白天时段发送“即将过期”提醒
NOTIFY_DAY_START=9
NOTIFY_DAY_END=21
# 登录二维码有效期（秒）
QR_TTL_SECONDS=300
# 同一二维码重复点击“接收登录二维码”时，最短邮件重发间隔（秒）
QR_EMAIL_RESEND_SECONDS=10
# 新 Token 预计有效期（小时），无法从 JWT 推断时使用
TOKEN_TTL_HOURS=72

# ==================== Token 存储 ====================
# local：保存到项目根目录 config.json；remote：保存到 Redis
SAVE_MODE=local
REDIS_TOKEN=your_redis_password
REDIS_ADDR=your_redis_address:port
# 可选：状态文件位置（记录签到结果和提醒去重状态）
# STATE_FILE=./data/state.json

# ==================== SMTP 邮件配置 ====================
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=YourEmailAccount
SMTP_PASS=YourPassword
TO_EMAIL=UserEmail
EMAIL_FROM_NAME=校园签到助手

# ==================== 微信配置（可选） ====================
# APPID=wx4a23ae4b8f291087
