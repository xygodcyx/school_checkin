{
  "name": "school_checkin",
  "version": "2.0.0",
  "description": "常驻式校园自动签到 Webhook 服务：微信二维码登录、Token 过期提醒、每日 18:00 自动签到与 HTML 邮件通知",
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "pm2:start": "pm2 startOrRestart ecosystem.config.cjs",
    "pm2:restart": "pm2 restart school-checkin --update-env",
    "pm2:stop": "pm2 stop school-checkin",
    "pm2:delete": "pm2 delete school-checkin",
    "pm2:status": "pm2 status school-checkin",
    "pm2:logs": "pm2 logs school-checkin",
    "pm2:save": "pm2 save",
    "pm2:flush": "pm2 flush school-checkin"
  },
  "keywords": [
    "checkin",
    "webhook",
    "wechat",
    "bun"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.2.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.10",
    "redis": "^5.9.0",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "24.9.2",
    "@types/nodemailer": "7.0.3",
    "typescript": "^5.3.3"
  }
}
